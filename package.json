{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "1.1.0",
  "description": "将 DSH Web 界面封装为 macOS 桌面应用（常驻 Dock，自动拉起 DSH 服务）",
  "main": "main.js",
  "author": "xuquanke",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/gen-whale-icon.js",
    "dist": "electron-builder --mac dir",
    "dist:dmg": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.xuquanke.dsh-desktop",
    "productName": "DSH Desktop",
    "files": [
      "main.js",
      "loading.html",
      "lan-panel.html",
      "lan-panel.js",
      "preload.js",
      "lan-proxy.js",
      "assets/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "npmRebuild": false,
    "electronDownload": {
      "cache": ".electron-cache"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
